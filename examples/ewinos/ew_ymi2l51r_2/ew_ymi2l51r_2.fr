(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + 1/2 DC[PhiI1Y0, mu].DC[PhiI1Y0, mu]
    + 1/2 DC[PhiI3Y0bar[i1], mu].DC[PhiI3Y0[i1], mu]
    + DC[PhiI2Y3bar[i1], mu].DC[PhiI2Y3[i1], mu]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W, SU2d3}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - (1/2)*MPhiI1Y0^2 PhiI1Y0 PhiI1Y0
    - (1/2)*MPhiI3Y0^2 PhiI3Y0bar[i1] PhiI3Y0[i1]
    - MPhiI2Y3^2 PhiI2Y3bar[i1] PhiI2Y3[i1]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W, SU2d3}];

(* Interactions *)
LBSMInt := ExpandIndices[
    (* Trilinear couplings *)
    - muPhiI1Y0PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0 PhiI2Y3[i1] Phitilde[i2] - HC[muPhiI1Y0PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0 PhiI2Y3[i1] Phitilde[i2]]
    - muPhiI2Y3PhiI3Y0 SU2CG223[i1, i3, i2] PhiI2Y3[i1] PhiI3Y0[i2] Phitilde[i3] - HC[muPhiI2Y3PhiI3Y0 SU2CG223[i1, i3, i2] PhiI2Y3[i1] PhiI3Y0[i2] Phitilde[i3]]
    (* Quartic couplings *)
    - lambdaPhiI1Y0PhiI1Y0 SU2CG22[i1, i2] PhiI1Y0 PhiI1Y0 Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0PhiI3Y0 SU2CG223[i2, i3, i1] PhiI1Y0 PhiI3Y0[i1] Phitilde[i2] Phi[i3]
    - lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4] - HC[lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4]]
    - lambdaPhiI2Y3PhiI2Y3barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI2Y3PhiI2Y3barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI3Y0PhiI3Y0 SU2CG2233P1[i3, i4, i1, i2] PhiI3Y0[i1] PhiI3Y0[i2] Phitilde[i3] Phi[i4]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W, SU2d3}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
