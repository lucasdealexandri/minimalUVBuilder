(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + DC[PhiI2Y3F1bar[i1], mu].DC[PhiI2Y3F1[i1], mu]
    + DC[PhiI2Y3F2bar[i1], mu].DC[PhiI2Y3F2[i1], mu]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - MPhiI2Y3F1^2 PhiI2Y3F1bar[i1] PhiI2Y3F1[i1]
    - MPhiI2Y3F2^2 PhiI2Y3F2bar[i1] PhiI2Y3F2[i1]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    - lambdaPhiI2Y3F1PhiI2Y3F1 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F1[i1] PhiI2Y3F1[i2] Phitilde[i3] Phitilde[i4] - HC[lambdaPhiI2Y3F1PhiI2Y3F1 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F1[i1] PhiI2Y3F1[i2] Phitilde[i3] Phitilde[i4]]
    - lambdaPhiI2Y3F1PhiI2Y3F1barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3F1tilde[i1] PhiI2Y3F1[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI2Y3F1PhiI2Y3F1barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F1tilde[i1] PhiI2Y3F1[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI2Y3F1PhiI2Y3F2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F1[i1] PhiI2Y3F2[i2] Phitilde[i3] Phitilde[i4] - HC[lambdaPhiI2Y3F1PhiI2Y3F2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F1[i1] PhiI2Y3F2[i2] Phitilde[i3] Phitilde[i4]]
    - lambdaPhiI2Y3F1PhiI2Y3F2barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3F2tilde[i1] PhiI2Y3F1[i2] Phitilde[i3] Phi[i4] - HC[lambdaPhiI2Y3F1PhiI2Y3F2barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3F2tilde[i1] PhiI2Y3F1[i2] Phitilde[i3] Phi[i4]]
    - lambdaPhiI2Y3F1PhiI2Y3F2barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F2tilde[i1] PhiI2Y3F1[i2] Phitilde[i3] Phi[i4] - HC[lambdaPhiI2Y3F1PhiI2Y3F2barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F2tilde[i1] PhiI2Y3F1[i2] Phitilde[i3] Phi[i4]]
    - lambdaPhiI2Y3F2PhiI2Y3F2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F2[i1] PhiI2Y3F2[i2] Phitilde[i3] Phitilde[i4] - HC[lambdaPhiI2Y3F2PhiI2Y3F2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F2[i1] PhiI2Y3F2[i2] Phitilde[i3] Phitilde[i4]]
    - lambdaPhiI2Y3F2PhiI2Y3F2barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3F2tilde[i1] PhiI2Y3F2[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI2Y3F2PhiI2Y3F2barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3F2tilde[i1] PhiI2Y3F2[i2] Phitilde[i3] Phi[i4]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
