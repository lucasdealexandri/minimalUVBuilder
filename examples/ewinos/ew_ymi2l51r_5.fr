(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + I sibar[mu, sp1, sp2] (ChiI1Y0Lwbar[sp1].DC[ChiI1Y0Lw[sp2], mu])
    + I sibar[mu, sp1, sp2] (ChiI2Y3Lwbar[sp1, i1].DC[ChiI2Y3Lw[sp2, i1], mu])
    + I sibar[mu, sp1, sp2] (ChiI2Ym3Lwbar[sp1, i1].DC[ChiI2Ym3Lw[sp2, i1], mu])
    + I sibar[mu, sp1, sp2] (ChiI3Y0Lwbar[sp1, i1].DC[ChiI3Y0Lw[sp2, i1], mu])
  , FlavorExpand -> {FGenQ0C1, FGenQ3C1, SU2D, SU2W, SU2d3}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    + (1/2)*MChiI3Y0 SU2CG33[i1, i2] (ChiI3Y0Lw[sp1, i1].ChiI3Y0Lw[sp1, i2]) + HC[(1/2)*MChiI3Y0 SU2CG33[i1, i2] (ChiI3Y0Lw[sp1, i1].ChiI3Y0Lw[sp1, i2])]
    + MChiI2Y3ChiI2Ym3 SU2CG22[i1, i2] (ChiI2Ym3Lw[sp1, i1].ChiI2Y3Lw[sp1, i2]) + HC[MChiI2Y3ChiI2Ym3 SU2CG22[i1, i2] (ChiI2Ym3Lw[sp1, i1].ChiI2Y3Lw[sp1, i2])]
    - (1/2)*MChiI1Y0 (ChiI1Y0Lw[sp1].ChiI1Y0Lw[sp1]) - HC[(1/2)*MChiI1Y0 (ChiI1Y0Lw[sp1].ChiI1Y0Lw[sp1])]
  , FlavorExpand -> {FGenQ0C1, FGenQ3C1, SU2D, SU2W, SU2d3}];

(* Interactions *)
LBSMInt := ExpandIndices[
    - yChiI1Y0ChiI2Y3 SU2CG22[i1, i2] (ChiI1Y0Lw[sp1].ChiI2Y3Lw[sp1, i1]) Phitilde[i2] - HC[yChiI1Y0ChiI2Y3 SU2CG22[i1, i2] (ChiI1Y0Lw[sp1].ChiI2Y3Lw[sp1, i1]) Phitilde[i2]]
    - yChiI1Y0ChiI2Ym3 SU2CG22[i1, i2] (ChiI1Y0Lw[sp1].ChiI2Ym3Lw[sp1, i1]) Phi[i2] - HC[yChiI1Y0ChiI2Ym3 SU2CG22[i1, i2] (ChiI1Y0Lw[sp1].ChiI2Ym3Lw[sp1, i1]) Phi[i2]]
    - yChiI2Y3ChiI3Y0 SU2CG223[i1, i3, i2] (ChiI2Y3Lw[sp1, i1].ChiI3Y0Lw[sp1, i2]) Phitilde[i3] - HC[yChiI2Y3ChiI3Y0 SU2CG223[i1, i3, i2] (ChiI2Y3Lw[sp1, i1].ChiI3Y0Lw[sp1, i2]) Phitilde[i3]]
    - yChiI2Ym3ChiI3Y0 SU2CG223[i1, i3, i2] (ChiI2Ym3Lw[sp1, i1].ChiI3Y0Lw[sp1, i2]) Phi[i3] - HC[yChiI2Ym3ChiI3Y0 SU2CG223[i1, i3, i2] (ChiI2Ym3Lw[sp1, i1].ChiI3Y0Lw[sp1, i2]) Phi[i3]]
  , FlavorExpand -> {FGenQ0C1, FGenQ3C1, SU2D, SU2W, SU2d3}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
