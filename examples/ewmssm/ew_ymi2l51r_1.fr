(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + 1/2 DC[PhiI1Y0F1, mu].DC[PhiI1Y0F1, mu]
    + 1/2 DC[PhiI1Y0F2, mu].DC[PhiI1Y0F2, mu]
    + DC[PhiI1Y6bar, mu].DC[PhiI1Y6, mu]
    + DC[PhiI2Y3bar[i1], mu].DC[PhiI2Y3[i1], mu]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - (1/2)*MPhiI1Y0F1^2 PhiI1Y0F1 PhiI1Y0F1
    - (1/2)*MPhiI1Y0F2^2 PhiI1Y0F2 PhiI1Y0F2
    - MPhiI1Y6^2 PhiI1Y6bar PhiI1Y6
    - MPhiI2Y3^2 PhiI2Y3bar[i1] PhiI2Y3[i1]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    (* Trilinear couplings *)
    - muPhiI1Y0F1PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0F1 PhiI2Y3[i1] Phitilde[i2] - HC[muPhiI1Y0F1PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0F1 PhiI2Y3[i1] Phitilde[i2]]
    - muPhiI1Y0F2PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0F2 PhiI2Y3[i1] Phitilde[i2] - HC[muPhiI1Y0F2PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0F2 PhiI2Y3[i1] Phitilde[i2]]
    - muPhiI2Y3PhiI1Y6bar SU2CG22[i1, i2] PhiI1Y6bar PhiI2Y3[i1] Phi[i2] - HC[muPhiI2Y3PhiI1Y6bar SU2CG22[i1, i2] PhiI1Y6bar PhiI2Y3[i1] Phi[i2]]
    (* Quartic couplings *)
    - lambdaPhiI1Y0F1PhiI1Y0F1 SU2CG22[i1, i2] PhiI1Y0F1 PhiI1Y0F1 Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0F1PhiI1Y0F2 SU2CG22[i1, i2] PhiI1Y0F1 PhiI1Y0F2 Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0F2PhiI1Y0F2 SU2CG22[i1, i2] PhiI1Y0F2 PhiI1Y0F2 Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y6PhiI1Y6bar SU2CG22[i1, i2] PhiI1Y6bar PhiI1Y6 Phitilde[i1] Phi[i2]
    - lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4] - HC[lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4]]
    - lambdaPhiI2Y3PhiI2Y3barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI2Y3PhiI2Y3barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
  , FlavorExpand -> {SGenQ0C1, SGenQ3C1, SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
