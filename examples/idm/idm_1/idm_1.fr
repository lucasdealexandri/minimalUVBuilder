(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + DC[PhiI2Y3bar[i1], mu].DC[PhiI2Y3[i1], mu]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - MPhiI2Y3^2 PhiI2Y3bar[i1] PhiI2Y3[i1]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    - lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4] - HC[lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4]]
    - lambdaPhiI2Y3PhiI2Y3barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI2Y3PhiI2Y3barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
