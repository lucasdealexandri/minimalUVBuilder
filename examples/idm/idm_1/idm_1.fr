               Definitions    -> {PhiI2Y3[1] :> Hp, PhiI2Y3[2] :> Module[{j}, (UMixRH0A0[1, j] + I*UMixRH0A0[2, j])/Sqrt[2] PhiQ0C1[j]]}
              },
   S[104] == {
               ClassName      -> PhiI2Y3tilde,
               QuantumNumbers -> {Y -> -1/2},
               SelfConjugate  -> False,
               Unphysical     -> True,
               Indices        -> {Index[SU2D]},
               FlavorIndex    -> SU2D,
