M$ModelName = "idm_2";

M$Information = {
  Authors -> {"Andre Lessa & Lucas Heck"},
  Version -> "1.0",
  Date    -> "24.11.2026"
};

FeynmanGauge = True;

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[FGenQ0C1]] = Range[2];
IndexStyle[FGenQ0C1,A];

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {

  (* Mass terms: external parameters *)
  MChiI2Y3ChiI2Ym3 == {
    ParameterType    -> External,
    BlockName        -> BSMMASS,
    OrderBlock       -> 1,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Dirac mass of ChiI2Ym3 ChiI2Y3"
  },

  (* Mixing matrices: external parameters *)
  RUMixMH0A0 == {
    ParameterType    -> External,
    BlockName        -> UMIXMH0A0,
    Indices          -> {Index[FGenQ0C1], Index[FGenQ0C1]},
    Value            -> {RUMixMH0A0[1, 1] -> 1, RUMixMH0A0[1, 2] -> 0,
                         RUMixMH0A0[2, 1] -> 0, RUMixMH0A0[2, 2] -> 1},
    ComplexParameter -> False,
    Description      -> "Mixing matrix of H0, A0 (real part)"
  },
  IUMixMH0A0 == {
    ParameterType    -> External,
    BlockName        -> IMUMIXMH0A0,
    Indices          -> {Index[FGenQ0C1], Index[FGenQ0C1]},
    Value            -> {IUMixMH0A0[1, 1] -> 0, IUMixMH0A0[1, 2] -> 0,
                         IUMixMH0A0[2, 1] -> 0, IUMixMH0A0[2, 2] -> 0},
    ComplexParameter -> False,
    Description      -> "Mixing matrix of H0, A0 (imaginary part)"
  },

  (* Mixing matrices: internal parameters *)
  UMixMH0A0 == {
    ParameterType    -> Internal,
    Indices          -> {Index[FGenQ0C1], Index[FGenQ0C1]},
    Unitary          -> True,
    Value            -> {UMixMH0A0[i_, j_] :> RUMixMH0A0[i, j] + I*IUMixMH0A0[i, j]},
    ComplexParameter -> True,
    Description      -> "Mixing matrix of H0, A0"
  },

  (* Mass-eigenstate phases: internal parameters *)
  PHp == {
    ParameterType    -> Internal,
    Value            -> -Conjugate[MChiI2Y3ChiI2Ym3]/Abs[MChiI2Y3ChiI2Ym3],
    ComplexParameter -> True,
    Description      -> "Phase of Hp: positive Dirac mass"
  },

  (* SU(2) Clebsch-Gordan tensors: internal parameters *)
  SU2CG22 == {
    ParameterType    -> Internal,
    Indices          -> {Index[SU2D], Index[SU2D]},
    Definitions      -> {SU2CG22[1, 2] -> 1,
                         SU2CG22[2, 1] -> -1,
                         SU2CG22[i1_?NumericQ, i2_?NumericQ] :> 0},
    ComplexParameter -> False
  }

};

