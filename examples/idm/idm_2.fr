               Mass           -> {MHp, 250.0},
               Width          -> {WHp, 2.5},
               PDG            -> {1000024}
              },

(***  Multiplet (gauge eigenstates) Fields ***)
   W[104] == {
               ClassName      -> ChiI2Ym3Lw,
               QuantumNumbers -> {Y -> -1/2},
               SelfConjugate  -> False,
               Unphysical     -> True,
               Chirality      -> Left,
               Indices        -> {Index[SU2D]},
               FlavorIndex    -> SU2D,
               Definitions    -> {ChiI2Ym3Lw[s_, 1] :> Module[{j}, UMixMH0A0[2, j] ChiQ0C1Lw[s, j]], ChiI2Ym3Lw[s_, 2] :> PHp HpRwbar[s]}
              },
   W[105] == {
               ClassName      -> ChiI2Y3Lw,
               QuantumNumbers -> {Y -> 1/2},
               SelfConjugate  -> False,
