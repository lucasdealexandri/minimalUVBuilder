M$ModelName = "sddm_1";

M$Information = {
  Authors -> {"Andre Lessa & Lucas Heck"},
  Version -> "1.0",
  Date    -> "25.11.2026"
};

FeynmanGauge = True;

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[SGenQ0C1]] = Range[3];
IndexStyle[SGenQ0C1,A];

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {

  (* Mass terms: external parameters *)
  MPhiI1Y0 == {
    ParameterType    -> External,
    BlockName        -> BSMMASS,
    OrderBlock       -> 1,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Mass of PhiI1Y0"
  },
  MPhiI2Y3 == {
    ParameterType    -> External,
    BlockName        -> BSMMASS,
    OrderBlock       -> 2,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Mass of PhiI2Y3"
  },

  (* Trilinear couplings: external parameters *)
  RmuPhiI1Y0PhiI2Y3 == {
    ParameterType    -> External,
    BlockName        -> BSMTRILINEAR,
    OrderBlock       -> 1,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Trilinear coupling PhiI1Y0 PhiI2Y3 Phibar (real part)"
  },
  ImuPhiI1Y0PhiI2Y3 == {
    ParameterType    -> External,
    BlockName        -> IMBSMTRILINEAR,
    OrderBlock       -> 1,
    Value            -> 0,
    ComplexParameter -> False,
    Description      -> "Trilinear coupling PhiI1Y0 PhiI2Y3 Phibar (imaginary part)"
  },

  (* Trilinear couplings: internal parameters *)
  muPhiI1Y0PhiI2Y3 == {
    ParameterType    -> Internal,
    Value            -> RmuPhiI1Y0PhiI2Y3 + I*ImuPhiI1Y0PhiI2Y3,
    ComplexParameter -> True,
    InteractionOrder -> {QED, 1},
    Description      -> "Trilinear coupling PhiI1Y0 PhiI2Y3 Phibar"
  },

  (* Quartic couplings: external parameters *)
  lambdaPhiI1Y0PhiI1Y0 == {
    ParameterType    -> External,
    BlockName        -> BSMQUARTIC,
    OrderBlock       -> 1,
    Value            -> 1,
    ComplexParameter -> False,
    InteractionOrder -> {QED, 2},
    Description      -> "Quartic coupling PhiI1Y0 PhiI1Y0 Phibar Phi"
  },
  RlambdaPhiI2Y3PhiI2Y3 == {
    ParameterType    -> External,
    BlockName        -> BSMQUARTIC,
    OrderBlock       -> 2,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Quartic coupling PhiI2Y3 PhiI2Y3 Phibar Phibar (real part)"
  },
  IlambdaPhiI2Y3PhiI2Y3 == {
    ParameterType    -> External,
    BlockName        -> IMBSMQUARTIC,
    OrderBlock       -> 2,
    Value            -> 0,
    ComplexParameter -> False,
    Description      -> "Quartic coupling PhiI2Y3 PhiI2Y3 Phibar Phibar (imaginary part)"
  },
  lambdaPhiI2Y3PhiI2Y3barP1 == {
    ParameterType    -> External,
    BlockName        -> BSMQUARTIC,
    OrderBlock       -> 3,
    Value            -> 1,
    ComplexParameter -> False,
    InteractionOrder -> {QED, 2},
    Description      -> "Quartic coupling PhiI2Y3bar PhiI2Y3 Phibar Phi (SU(2) invariant P1)"
  },
  lambdaPhiI2Y3PhiI2Y3barP2 == {
    ParameterType    -> External,
    BlockName        -> BSMQUARTIC,
    OrderBlock       -> 4,
    Value            -> 1,
    ComplexParameter -> False,
    InteractionOrder -> {QED, 2},
    Description      -> "Quartic coupling PhiI2Y3bar PhiI2Y3 Phibar Phi (SU(2) invariant P2)"
  },

  (* Quartic couplings: internal parameters *)
  lambdaPhiI2Y3PhiI2Y3 == {
    ParameterType    -> Internal,
    Value            -> RlambdaPhiI2Y3PhiI2Y3 + I*IlambdaPhiI2Y3PhiI2Y3,
    ComplexParameter -> True,
    InteractionOrder -> {QED, 2},
    Description      -> "Quartic coupling PhiI2Y3 PhiI2Y3 Phibar Phibar"
  },

  (* Mixing matrices: external parameters *)
  UMixRZ1Z2Z3 == {
    ParameterType    -> External,
    BlockName        -> UMIXRZ1Z2Z3,
    Indices          -> {Index[SGenQ0C1], Index[SGenQ0C1]},
    Unitary          -> True,
    Value            -> {UMixRZ1Z2Z3[1, 1] -> 1, UMixRZ1Z2Z3[1, 2] -> 0, UMixRZ1Z2Z3[1, 3] -> 0,
                         UMixRZ1Z2Z3[2, 1] -> 0, UMixRZ1Z2Z3[2, 2] -> 1, UMixRZ1Z2Z3[2, 3] -> 0,
                         UMixRZ1Z2Z3[3, 1] -> 0, UMixRZ1Z2Z3[3, 2] -> 0, UMixRZ1Z2Z3[3, 3] -> 1},
    ComplexParameter -> False,
    Description      -> "Mixing matrix of Z1, Z2, Z3 (real orthogonal)"
  },

  (* SU(2) Clebsch-Gordan tensors: internal parameters *)
  SU2CG22 == {
    ParameterType    -> Internal,
    Indices          -> {Index[SU2D], Index[SU2D]},
    Definitions      -> {SU2CG22[1, 2] -> 1,
                         SU2CG22[2, 1] -> -1,
                         SU2CG22[i1_?NumericQ, i2_?NumericQ] :> 0},
    ComplexParameter -> False
  },
  SU2CG2222P1 == {
    ParameterType    -> Internal,
    Indices          -> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
    Definitions      -> {SU2CG2222P1[1, 2, 1, 2] -> 1/2,
                         SU2CG2222P1[1, 2, 2, 1] -> -1/2,
                         SU2CG2222P1[2, 1, 1, 2] -> -1/2,
                         SU2CG2222P1[2, 1, 2, 1] -> 1/2,
                         SU2CG2222P1[i1_?NumericQ, i2_?NumericQ, i3_?NumericQ, i4_?NumericQ] :> 0},
    ComplexParameter -> False
  },
  SU2CG2222P2 == {
    ParameterType    -> Internal,
    Indices          -> {Index[SU2D], Index[SU2D], Index[SU2D], Index[SU2D]},
    Definitions      -> {SU2CG2222P2[1, 1, 2, 2] -> (1/3)*3^(1/2),
                         SU2CG2222P2[1, 2, 1, 2] -> -1/6*3^(1/2),
                         SU2CG2222P2[1, 2, 2, 1] -> -1/6*3^(1/2),
                         SU2CG2222P2[2, 1, 1, 2] -> -1/6*3^(1/2),
                         SU2CG2222P2[2, 1, 2, 1] -> -1/6*3^(1/2),
                         SU2CG2222P2[2, 2, 1, 1] -> (1/3)*3^(1/2),
                         SU2CG2222P2[i1_?NumericQ, i2_?NumericQ, i3_?NumericQ, i4_?NumericQ] :> 0},
    ComplexParameter -> False
  }

};

(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)

M$ClassesDescription = {

(***  Physical (mass eigenstates) Fields ***)
   S[101] == {
               ClassName      -> PhiQ0C1,
               ClassMembers   -> {Z1,Z2,Z3},
               SelfConjugate  -> True,
               Mass           -> {MPhiQ0C1, {MZ1, 109.28073066053803}, {MZ2, 289.8396349703101}, {MZ3, 430.5589043097719}},
               Width          -> {WPhiQ0C1, {WZ1, 0.0}, {WZ2, 2.898396349703101}, {WZ3, 4.305589043097719}},
               PDG            -> {1000022, 1000023, 1000025},
               Indices        -> {Index[SGenQ0C1]},
               FlavorIndex    -> SGenQ0C1
              },
   S[102] == {
               ClassName      -> W1,
               QuantumNumbers -> {Q -> 1},
               SelfConjugate  -> False,
               Mass           -> {MW1, 200.0},
               Width          -> {WW1, 2.0},
               PDG            -> {1000024}
              },

(***  Multiplet (gauge eigenstates) Fields ***)
   S[103] == {
               ClassName      -> PhiI1Y0,
               SelfConjugate  -> True,
               Unphysical     -> True,
               Definitions    -> {PhiI1Y0 :> Module[{j}, UMixRZ1Z2Z3[1, j] PhiQ0C1[j]]}
              },
   S[104] == {
               ClassName      -> PhiI2Y3,
               QuantumNumbers -> {Y -> 1/2},
               SelfConjugate  -> False,
               Unphysical     -> True,
               Indices        -> {Index[SU2D]},
               FlavorIndex    -> SU2D,
               Definitions    -> {PhiI2Y3[1] :> W1, PhiI2Y3[2] :> Module[{j}, (UMixRZ1Z2Z3[2, j] + I*UMixRZ1Z2Z3[3, j])/Sqrt[2] PhiQ0C1[j]]}
              },
   S[105] == {
               ClassName      -> PhiI2Y3tilde,
               QuantumNumbers -> {Y -> -1/2},
               SelfConjugate  -> False,
               Unphysical     -> True,
               Indices        -> {Index[SU2D]},
               FlavorIndex    -> SU2D,
               Definitions    -> {PhiI2Y3tilde[2] :> -PhiI2Y3bar[1], PhiI2Y3tilde[1] :> PhiI2Y3bar[2]}
              }
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + 1/2 DC[PhiI1Y0, mu].DC[PhiI1Y0, mu]
    + DC[PhiI2Y3bar[i1], mu].DC[PhiI2Y3[i1], mu]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - (1/2)*MPhiI1Y0^2 PhiI1Y0 PhiI1Y0
    - MPhiI2Y3^2 PhiI2Y3bar[i1] PhiI2Y3[i1]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    (* Trilinear couplings *)
    - muPhiI1Y0PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0 PhiI2Y3[i1] Phitilde[i2] - HC[muPhiI1Y0PhiI2Y3 SU2CG22[i1, i2] PhiI1Y0 PhiI2Y3[i1] Phitilde[i2]]
    (* Quartic couplings *)
    - lambdaPhiI1Y0PhiI1Y0 SU2CG22[i1, i2] PhiI1Y0 PhiI1Y0 Phitilde[i1] Phi[i2]
    - lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4] - HC[lambdaPhiI2Y3PhiI2Y3 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3[i1] PhiI2Y3[i2] Phitilde[i3] Phitilde[i4]]
    - lambdaPhiI2Y3PhiI2Y3barP1 SU2CG2222P1[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
    - lambdaPhiI2Y3PhiI2Y3barP2 SU2CG2222P2[i1, i2, i3, i4] PhiI2Y3tilde[i1] PhiI2Y3[i2] Phitilde[i3] Phi[i4]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
