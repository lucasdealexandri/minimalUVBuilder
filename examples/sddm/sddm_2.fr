M$ClassesDescription = {

(***  Physical (mass eigenstates) Fields ***)
   W[101] == {
               ClassName      -> ChiQ0C1Lw,
               QuantumNumbers -> {Q -> 0},
               SelfConjugate  -> False,
               Unphysical     -> True,
               Chirality      -> Left,
               Indices        -> {Index[FGenQ0C1]},
               FlavorIndex    -> FGenQ0C1
              },
   F[101] == {
               ClassName      -> ChiQ0C1,
               ClassMembers   -> {Z1,Z2,Z3},
               SelfConjugate  -> True,
               WeylComponents -> ChiQ0C1Lw,
               Mass           -> {MChiQ0C1, {MZ1, 109.28073066053803}, {MZ2, 289.8396349703101}, {MZ3, 430.5589043097719}},
               Width          -> {WChiQ0C1, {WZ1, 0.0}, {WZ2, 2.898396349703101}, {WZ3, 4.305589043097719}},
               PDG            -> {1000022, 1000023, 1000025},
               Indices        -> {Index[FGenQ0C1]},
