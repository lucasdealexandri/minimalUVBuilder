M$ModelName = "sddm_2";

M$Information = {
  Authors -> {"Andre Lessa & Lucas Heck"},
  Version -> "1.0",
  Date    -> "24.11.2026"
};

FeynmanGauge = True;

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[FGenQ0C1]] = Range[3];
IndexStyle[FGenQ0C1,A];

(* ************************** *)
(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {

  (* Mass terms: external parameters *)
  MChiI1Y0 == {
    ParameterType    -> External,
    BlockName        -> BSMMASS,
    OrderBlock       -> 1,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Majorana mass of ChiI1Y0"
  },
  MChiI2Y3ChiI2Ym3 == {
    ParameterType    -> External,
    BlockName        -> BSMMASS,
    OrderBlock       -> 2,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Dirac mass of ChiI2Ym3 ChiI2Y3"
  },

  (* Yukawa couplings: external parameters *)
  RyChiI1Y0ChiI2Y3 == {
    ParameterType    -> External,
    BlockName        -> BSMYUKAWA,
    OrderBlock       -> 1,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Yukawa coupling ChiI1Y0 ChiI2Y3 Phibar (real part)"
  },
  IyChiI1Y0ChiI2Y3 == {
    ParameterType    -> External,
    BlockName        -> IMBSMYUKAWA,
    OrderBlock       -> 1,
    Value            -> 0,
    ComplexParameter -> False,
    Description      -> "Yukawa coupling ChiI1Y0 ChiI2Y3 Phibar (imaginary part)"
  },
  RyChiI1Y0ChiI2Ym3 == {
    ParameterType    -> External,
    BlockName        -> BSMYUKAWA,
    OrderBlock       -> 2,
    Value            -> 1,
    ComplexParameter -> False,
    Description      -> "Yukawa coupling ChiI1Y0 ChiI2Ym3 Phi (real part)"
  },
  IyChiI1Y0ChiI2Ym3 == {
    ParameterType    -> External,
    BlockName        -> IMBSMYUKAWA,
    OrderBlock       -> 2,
    Value            -> 0,
    ComplexParameter -> False,
    Description      -> "Yukawa coupling ChiI1Y0 ChiI2Ym3 Phi (imaginary part)"
  },

  (* Yukawa couplings: internal parameters *)
  yChiI1Y0ChiI2Y3 == {
    ParameterType    -> Internal,
    Value            -> RyChiI1Y0ChiI2Y3 + I*IyChiI1Y0ChiI2Y3,
    ComplexParameter -> True,
    InteractionOrder -> {QED, 1},
    Description      -> "Yukawa coupling ChiI1Y0 ChiI2Y3 Phibar"
  },
  yChiI1Y0ChiI2Ym3 == {
    ParameterType    -> Internal,
    Value            -> RyChiI1Y0ChiI2Ym3 + I*IyChiI1Y0ChiI2Ym3,
    ComplexParameter -> True,
    InteractionOrder -> {QED, 1},
    Description      -> "Yukawa coupling ChiI1Y0 ChiI2Ym3 Phi"
  },

  (* Mixing matrices: external parameters *)
  RUMixMZ1Z2Z3 == {
    ParameterType    -> External,
    BlockName        -> UMIXMZ1Z2Z3,
    Indices          -> {Index[FGenQ0C1], Index[FGenQ0C1]},
    Value            -> {RUMixMZ1Z2Z3[1, 1] -> 1, RUMixMZ1Z2Z3[1, 2] -> 0, RUMixMZ1Z2Z3[1, 3] -> 0,
                         RUMixMZ1Z2Z3[2, 1] -> 0, RUMixMZ1Z2Z3[2, 2] -> 1, RUMixMZ1Z2Z3[2, 3] -> 0,
                         RUMixMZ1Z2Z3[3, 1] -> 0, RUMixMZ1Z2Z3[3, 2] -> 0, RUMixMZ1Z2Z3[3, 3] -> 1},
    ComplexParameter -> False,
    Description      -> "Mixing matrix of Z1, Z2, Z3 (real part)"
  },
  IUMixMZ1Z2Z3 == {
    ParameterType    -> External,
    BlockName        -> IMUMIXMZ1Z2Z3,
    Indices          -> {Index[FGenQ0C1], Index[FGenQ0C1]},
    Value            -> {IUMixMZ1Z2Z3[1, 1] -> 0, IUMixMZ1Z2Z3[1, 2] -> 0, IUMixMZ1Z2Z3[1, 3] -> 0,
                         IUMixMZ1Z2Z3[2, 1] -> 0, IUMixMZ1Z2Z3[2, 2] -> 0, IUMixMZ1Z2Z3[2, 3] -> 0,
                         IUMixMZ1Z2Z3[3, 1] -> 0, IUMixMZ1Z2Z3[3, 2] -> 0, IUMixMZ1Z2Z3[3, 3] -> 0},
    ComplexParameter -> False,
    Description      -> "Mixing matrix of Z1, Z2, Z3 (imaginary part)"
  },

  (* Mixing matrices: internal parameters *)
  UMixMZ1Z2Z3 == {
    ParameterType    -> Internal,
    Indices          -> {Index[FGenQ0C1], Index[FGenQ0C1]},
    Unitary          -> True,
    Value            -> {UMixMZ1Z2Z3[i_, j_] :> RUMixMZ1Z2Z3[i, j] + I*IUMixMZ1Z2Z3[i, j]},
    ComplexParameter -> True,
    Description      -> "Mixing matrix of Z1, Z2, Z3"
  },

  (* Mass-eigenstate phases: internal parameters *)
  PW1 == {
    ParameterType    -> Internal,
    Value            -> -Conjugate[MChiI2Y3ChiI2Ym3]/Abs[MChiI2Y3ChiI2Ym3],
    ComplexParameter -> True,
    Description      -> "Phase of W1: positive Dirac mass"
  },

  (* SU(2) Clebsch-Gordan tensors: internal parameters *)
  SU2CG22 == {
    ParameterType    -> Internal,
    Indices          -> {Index[SU2D], Index[SU2D]},
    Definitions      -> {SU2CG22[1, 2] -> 1,
                         SU2CG22[2, 1] -> -1,
                         SU2CG22[i1_?NumericQ, i2_?NumericQ] :> 0},
    ComplexParameter -> False
  }

};

