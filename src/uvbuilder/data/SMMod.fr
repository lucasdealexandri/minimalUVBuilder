  U1Y  == { 
    Abelian          -> True,  
    CouplingConstant -> g1, 
    GaugeBoson       -> B, 
    Charge           -> Y
  },
  SU2L == { 
    Abelian           -> False, 
    CouplingConstant  -> gw, 
    GaugeBoson        -> Wi, 
    StructureConstant -> Eps, 
    Representations   -> {{Ta,SU2D}, {TSU2d3,SU2d3}, {TSU2d4,SU2d4}, {TSU2d5,SU2d5}, {TSU2d6,SU2d6}, {TSU2d7,SU2d7}, {TSU2d8,SU2d8}, {TSU2d9,SU2d9}, {TSU2d10,SU2d10}}, 
    Definitions       -> {Ta[a_,b_,c_]->PauliSigma[a,b,c]/2, FSU2L[i_,j_,k_]:> I Eps[i,j,k]}
  },
  SU3C == { 
    Abelian           -> False, 
    CouplingConstant  -> gs, 
    GaugeBoson        -> G,
    StructureConstant -> f, 
    Representations   -> {{T,Colour}, {T6,Sextet}}, 
    SymmetricTensor   -> dSUN
  } 
};


(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[SU2W      ]] = Unfold[Range[3]]; 
IndexRange[Index[SU2D      ]] = Unfold[Range[2]];
IndexRange[Index[Gluon     ]] = NoUnfold[Range[8]];
IndexRange[Index[Colour    ]] = NoUnfold[Range[3]]; 
IndexRange[Index[Sextet    ]] = NoUnfold[Range[6]];
IndexRange[Index[Generation]] = Range[3];
IndexRange[Index[SU2d3     ]] = Unfold[Range[3]];
IndexRange[Index[SU2d4     ]] = Unfold[Range[4]];
IndexRange[Index[SU2d5     ]] = Unfold[Range[5]];
IndexRange[Index[SU2d6     ]] = Unfold[Range[6]];
IndexRange[Index[SU2d7     ]] = Unfold[Range[7]];
IndexRange[Index[SU2d8     ]] = Unfold[Range[8]];
IndexRange[Index[SU2d9     ]] = Unfold[Range[9]];
IndexRange[Index[SU2d10    ]] = Unfold[Range[10]];

IndexStyle[SU2W,       j];
IndexStyle[SU2D,       k];
IndexStyle[Gluon,      a];
IndexStyle[Colour,     m];
IndexStyle[Sextet,     n];
IndexStyle[Generation, f];
IndexStyle[SU2d3,      jd3];
IndexStyle[SU2d4,      jd4];
IndexStyle[SU2d5,      jd5];
IndexStyle[SU2d6,      jd6];
IndexStyle[SU2d7,      jd7];
IndexStyle[SU2d8,      jd8];
IndexStyle[SU2d9,      jd9];
IndexStyle[SU2d10,     jd10];

(* BSM SU(2) multiplets of dimension d = 3..10 carry the index SU2d<d> (d = 2: SU2D).        *)
(* Basis: index 1 = highest i3 (charge eigenstates), Condon-Shortley phases -- the same      *)
(* convention as the generated CG tensors. SU2W stays the adjoint (Cartesian) index of Wi.    *)
(* Generators TSU2d<d>[a, i, k] = (J^a)_{ik}, spin j = (d-1)/2; d = 2 would give PauliSigma/2. *)
(* They evaluate only on explicit integer indices, so FeynRules' symbolic index rules never  *)
(* loop on them. Larger d: extend Range[3, 10] here, in Representations and in the indices.   *)
SU2Gen[d_Integer, a_Integer, i_Integer, k_Integer] := Module[{j = (d - 1)/2, m1, m2, up, dn},
   m1 = j + 1 - i; m2 = j + 1 - k;
   up = Sqrt[j (j + 1) - m2 (m2 + 1)] KroneckerDelta[m1, m2 + 1];
   dn = Sqrt[j (j + 1) - m2 (m2 - 1)] KroneckerDelta[m1, m2 - 1];
   Which[a == 1, (up + dn)/2, a == 2, (up - dn)/(2 I), a == 3, m1 KroneckerDelta[i, k]]];
Do[With[{gen = Symbol["TSU2d" <> ToString[dim]], dd = dim},
     gen[Index[_, su2a_Integer], Index[_, su2i_Integer], Index[_, su2k_Integer]] := SU2Gen[dd, su2a, su2i, su2k];
     gen[su2a_Integer, su2i_Integer, su2k_Integer] := SU2Gen[dd, su2a, su2i, su2k]],
   {dim, 3, 10}];


