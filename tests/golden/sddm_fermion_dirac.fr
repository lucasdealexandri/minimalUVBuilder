(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + I sibar[mu, sp1, sp2] (ChiI1Y0D1F1Lwbar[sp1].DC[ChiI1Y0D1F1Lw[sp2], mu])
    + I sibar[mu, sp1, sp2] (ChiI1Y0D1F2Lwbar[sp1].DC[ChiI1Y0D1F2Lw[sp2], mu])
    + I sibar[mu, sp1, sp2] (ChiI1Y0Dm1F1Lwbar[sp1].DC[ChiI1Y0Dm1F1Lw[sp2], mu])
    + I sibar[mu, sp1, sp2] (ChiI1Y0Dm1F2Lwbar[sp1].DC[ChiI1Y0Dm1F2Lw[sp2], mu])
    + I sibar[mu, sp1, sp2] (ChiI2Y3D1Lwbar[sp1, i1].DC[ChiI2Y3D1Lw[sp2, i1], mu])
    + I sibar[mu, sp1, sp2] (ChiI2Ym3Dm1Lwbar[sp1, i1].DC[ChiI2Ym3Dm1Lw[sp2, i1], mu])
  , FlavorExpand -> {FGenQ0C1D1, SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - MChiI1Y0D1F1ChiI1Y0Dm1F1 (ChiI1Y0Dm1F1Lw[sp1].ChiI1Y0D1F1Lw[sp1]) - HC[MChiI1Y0D1F1ChiI1Y0Dm1F1 (ChiI1Y0Dm1F1Lw[sp1].ChiI1Y0D1F1Lw[sp1])]
    - MChiI1Y0D1F2ChiI1Y0Dm1F2 (ChiI1Y0Dm1F2Lw[sp1].ChiI1Y0D1F2Lw[sp1]) - HC[MChiI1Y0D1F2ChiI1Y0Dm1F2 (ChiI1Y0Dm1F2Lw[sp1].ChiI1Y0D1F2Lw[sp1])]
    - MChiI2Y3D1ChiI2Ym3Dm1 SU2CG22[i1, i2] (ChiI2Ym3Dm1Lw[sp1, i1].ChiI2Y3D1Lw[sp1, i2]) - HC[MChiI2Y3D1ChiI2Ym3Dm1 SU2CG22[i1, i2] (ChiI2Ym3Dm1Lw[sp1, i1].ChiI2Y3D1Lw[sp1, i2])]
  , FlavorExpand -> {FGenQ0C1D1, SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    - yChiI1Y0D1F1ChiI2Ym3Dm1 SU2CG22[i1, i2] (ChiI2Ym3Dm1Lw[sp1, i1].ChiI1Y0D1F1Lw[sp1]) Phi[i2] - HC[yChiI1Y0D1F1ChiI2Ym3Dm1 SU2CG22[i1, i2] (ChiI2Ym3Dm1Lw[sp1, i1].ChiI1Y0D1F1Lw[sp1]) Phi[i2]]
    - yChiI1Y0D1F2ChiI2Ym3Dm1 SU2CG22[i1, i2] (ChiI2Ym3Dm1Lw[sp1, i1].ChiI1Y0D1F2Lw[sp1]) Phi[i2] - HC[yChiI1Y0D1F2ChiI2Ym3Dm1 SU2CG22[i1, i2] (ChiI2Ym3Dm1Lw[sp1, i1].ChiI1Y0D1F2Lw[sp1]) Phi[i2]]
    - yChiI2Y3D1ChiI1Y0Dm1F1 SU2CG22[i1, i2] (ChiI1Y0Dm1F1Lw[sp1].ChiI2Y3D1Lw[sp1, i1]) Phitilde[i2] - HC[yChiI2Y3D1ChiI1Y0Dm1F1 SU2CG22[i1, i2] (ChiI1Y0Dm1F1Lw[sp1].ChiI2Y3D1Lw[sp1, i1]) Phitilde[i2]]
    - yChiI2Y3D1ChiI1Y0Dm1F2 SU2CG22[i1, i2] (ChiI1Y0Dm1F2Lw[sp1].ChiI2Y3D1Lw[sp1, i1]) Phitilde[i2] - HC[yChiI2Y3D1ChiI1Y0Dm1F2 SU2CG22[i1, i2] (ChiI1Y0Dm1F2Lw[sp1].ChiI2Y3D1Lw[sp1, i1]) Phitilde[i2]]
  , FlavorExpand -> {FGenQ0C1D1, SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
