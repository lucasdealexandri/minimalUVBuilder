               Definitions    -> {PhiI3Y0[1] :> W1, PhiI3Y0[2] :> Module[{j}, UMixRZ1Z2Z3[3, j] PhiQ0C1[j]], PhiI3Y0[3] :> -W1bar}
              }
};

(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + 1/2 DC[PhiI1Y0F1, mu].DC[PhiI1Y0F1, mu]
    + 1/2 DC[PhiI1Y0F2, mu].DC[PhiI1Y0F2, mu]
    + 1/2 DC[PhiI3Y0bar[i1], mu].DC[PhiI3Y0[i1], mu]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W, SU2d3}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - (1/2)*MPhiI1Y0F1^2 PhiI1Y0F1 PhiI1Y0F1
    - (1/2)*MPhiI1Y0F2^2 PhiI1Y0F2 PhiI1Y0F2
    - (1/2)*MPhiI3Y0^2 PhiI3Y0bar[i1] PhiI3Y0[i1]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W, SU2d3}];

(* Interactions *)
LBSMInt := ExpandIndices[
    - lambdaPhiI1Y0F1PhiI1Y0F1 SU2CG22[i1, i2] PhiI1Y0F1 PhiI1Y0F1 Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0F1PhiI1Y0F2 SU2CG22[i1, i2] PhiI1Y0F1 PhiI1Y0F2 Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0F1PhiI3Y0 SU2CG223[i2, i3, i1] PhiI1Y0F1 PhiI3Y0[i1] Phitilde[i2] Phi[i3]
    - lambdaPhiI1Y0F2PhiI1Y0F2 SU2CG22[i1, i2] PhiI1Y0F2 PhiI1Y0F2 Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0F2PhiI3Y0 SU2CG223[i2, i3, i1] PhiI1Y0F2 PhiI3Y0[i1] Phitilde[i2] Phi[i3]
    - lambdaPhiI3Y0PhiI3Y0 SU2CG2233P1[i3, i4, i1, i2] PhiI3Y0[i1] PhiI3Y0[i2] Phitilde[i3] Phi[i4]
  , FlavorExpand -> {SGenQ0C1, SU2D, SU2W, SU2d3}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
