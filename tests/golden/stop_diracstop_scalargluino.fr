(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + DC[PhiC8I1Y0D1bar[c1], mu].DC[PhiC8I1Y0D1[c1], mu]
    + DC[PhiI1Y0D1bar, mu].DC[PhiI1Y0D1, mu]
    + I sibar[mu, sp1, sp2] (ChiC3I1Y4B1D1Lwbar[sp1, c1].DC[ChiC3I1Y4B1D1Lw[sp2, c1], mu])
    + I sibar[mu, sp1, sp2] (ChiC3I1Y4B1D1Rw[sp1, c1].DC[ChiC3I1Y4B1D1Rwbar[sp2, c1], mu])
  , FlavorExpand -> {SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - MChiC3I1Y4B1D1ChiC3bI1Ym4Bm1Dm1 (ChiC3bI1Ym4Bm1Dm1Lw[sp1, c1].ChiC3I1Y4B1D1Lw[sp1, c1]) - HC[MChiC3I1Y4B1D1ChiC3bI1Ym4Bm1Dm1 (ChiC3bI1Ym4Bm1Dm1Lw[sp1, c1].ChiC3I1Y4B1D1Lw[sp1, c1])]
    - MPhiC8I1Y0D1^2 PhiC8I1Y0D1bar[c1] PhiC8I1Y0D1[c1]
    - MPhiI1Y0D1^2 PhiI1Y0D1bar PhiI1Y0D1
  , FlavorExpand -> {SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    (* Yukawa couplings *)
    - zChiC3I1Y4B1D1PhiC8I1Y0D1barcRbar T[c1, c2, c3] PhiC8I1Y0D1bar[c1] (ChiC3I1Y4B1D1Lw[sp1, c3].uRwbar[sp1, 2, c2]) - HC[zChiC3I1Y4B1D1PhiC8I1Y0D1barcRbar T[c1, c2, c3] PhiC8I1Y0D1bar[c1] (ChiC3I1Y4B1D1Lw[sp1, c3].uRwbar[sp1, 2, c2])]
    - zChiC3I1Y4B1D1PhiC8I1Y0D1bartRbar T[c1, c2, c3] PhiC8I1Y0D1bar[c1] (ChiC3I1Y4B1D1Lw[sp1, c3].uRwbar[sp1, 3, c2]) - HC[zChiC3I1Y4B1D1PhiC8I1Y0D1bartRbar T[c1, c2, c3] PhiC8I1Y0D1bar[c1] (ChiC3I1Y4B1D1Lw[sp1, c3].uRwbar[sp1, 3, c2])]
    - zChiC3I1Y4B1D1PhiC8I1Y0D1baruRbar T[c1, c2, c3] PhiC8I1Y0D1bar[c1] (ChiC3I1Y4B1D1Lw[sp1, c3].uRwbar[sp1, 1, c2]) - HC[zChiC3I1Y4B1D1PhiC8I1Y0D1baruRbar T[c1, c2, c3] PhiC8I1Y0D1bar[c1] (ChiC3I1Y4B1D1Lw[sp1, c3].uRwbar[sp1, 1, c2])]
    - zChiC3I1Y4B1D1PhiI1Y0D1barcRbar PhiI1Y0D1bar (ChiC3I1Y4B1D1Lw[sp1, c1].uRwbar[sp1, 2, c1]) - HC[zChiC3I1Y4B1D1PhiI1Y0D1barcRbar PhiI1Y0D1bar (ChiC3I1Y4B1D1Lw[sp1, c1].uRwbar[sp1, 2, c1])]
    - zChiC3I1Y4B1D1PhiI1Y0D1bartRbar PhiI1Y0D1bar (ChiC3I1Y4B1D1Lw[sp1, c1].uRwbar[sp1, 3, c1]) - HC[zChiC3I1Y4B1D1PhiI1Y0D1bartRbar PhiI1Y0D1bar (ChiC3I1Y4B1D1Lw[sp1, c1].uRwbar[sp1, 3, c1])]
    - zChiC3I1Y4B1D1PhiI1Y0D1baruRbar PhiI1Y0D1bar (ChiC3I1Y4B1D1Lw[sp1, c1].uRwbar[sp1, 1, c1]) - HC[zChiC3I1Y4B1D1PhiI1Y0D1baruRbar PhiI1Y0D1bar (ChiC3I1Y4B1D1Lw[sp1, c1].uRwbar[sp1, 1, c1])]
    (* Quartic couplings *)
    - lambdaPhiC8I1Y0D1PhiC8I1Y0D1bar SU2CG22[i1, i2] PhiC8I1Y0D1bar[c1] PhiC8I1Y0D1[c1] Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0D1PhiI1Y0D1bar SU2CG22[i1, i2] PhiI1Y0D1bar PhiI1Y0D1 Phitilde[i1] Phi[i2]
  , FlavorExpand -> {SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
