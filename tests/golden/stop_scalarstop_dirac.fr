(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + DC[PhiC3I1Y4B1D1bar[c1], mu].DC[PhiC3I1Y4B1D1[c1], mu]
    + I sibar[mu, sp1, sp2] (ChiC8I1Y0D1Lwbar[sp1, c1].DC[ChiC8I1Y0D1Lw[sp2, c1], mu])
    + I sibar[mu, sp1, sp2] (ChiC8I1Y0Dm1Lwbar[sp1, c1].DC[ChiC8I1Y0Dm1Lw[sp2, c1], mu])
    + I sibar[mu, sp1, sp2] (ChiI1Y0D1Lwbar[sp1].DC[ChiI1Y0D1Lw[sp2], mu])
    + I sibar[mu, sp1, sp2] (ChiI1Y0Dm1Lwbar[sp1].DC[ChiI1Y0Dm1Lw[sp2], mu])
  , FlavorExpand -> {SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - MChiC8I1Y0D1ChiC8I1Y0Dm1 (ChiC8I1Y0Dm1Lw[sp1, c1].ChiC8I1Y0D1Lw[sp1, c1]) - HC[MChiC8I1Y0D1ChiC8I1Y0Dm1 (ChiC8I1Y0Dm1Lw[sp1, c1].ChiC8I1Y0D1Lw[sp1, c1])]
    - MChiI1Y0D1ChiI1Y0Dm1 (ChiI1Y0Dm1Lw[sp1].ChiI1Y0D1Lw[sp1]) - HC[MChiI1Y0D1ChiI1Y0Dm1 (ChiI1Y0Dm1Lw[sp1].ChiI1Y0D1Lw[sp1])]
    - MPhiC3I1Y4B1D1^2 PhiC3I1Y4B1D1bar[c1] PhiC3I1Y4B1D1[c1]
  , FlavorExpand -> {SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    (* Yukawa couplings *)
    - zPhiC3I1Y4B1D1ChiC8I1Y0Dm1cRbar T[c1, c2, c3] PhiC3I1Y4B1D1[c3] (ChiC8I1Y0Dm1Lw[sp1, c1].uRwbar[sp1, 2, c2]) - HC[zPhiC3I1Y4B1D1ChiC8I1Y0Dm1cRbar T[c1, c2, c3] PhiC3I1Y4B1D1[c3] (ChiC8I1Y0Dm1Lw[sp1, c1].uRwbar[sp1, 2, c2])]
    - zPhiC3I1Y4B1D1ChiC8I1Y0Dm1tRbar T[c1, c2, c3] PhiC3I1Y4B1D1[c3] (ChiC8I1Y0Dm1Lw[sp1, c1].uRwbar[sp1, 3, c2]) - HC[zPhiC3I1Y4B1D1ChiC8I1Y0Dm1tRbar T[c1, c2, c3] PhiC3I1Y4B1D1[c3] (ChiC8I1Y0Dm1Lw[sp1, c1].uRwbar[sp1, 3, c2])]
    - zPhiC3I1Y4B1D1ChiC8I1Y0Dm1uRbar T[c1, c2, c3] PhiC3I1Y4B1D1[c3] (ChiC8I1Y0Dm1Lw[sp1, c1].uRwbar[sp1, 1, c2]) - HC[zPhiC3I1Y4B1D1ChiC8I1Y0Dm1uRbar T[c1, c2, c3] PhiC3I1Y4B1D1[c3] (ChiC8I1Y0Dm1Lw[sp1, c1].uRwbar[sp1, 1, c2])]
    - zPhiC3I1Y4B1D1ChiI1Y0Dm1cRbar PhiC3I1Y4B1D1[c1] (ChiI1Y0Dm1Lw[sp1].uRwbar[sp1, 2, c1]) - HC[zPhiC3I1Y4B1D1ChiI1Y0Dm1cRbar PhiC3I1Y4B1D1[c1] (ChiI1Y0Dm1Lw[sp1].uRwbar[sp1, 2, c1])]
    - zPhiC3I1Y4B1D1ChiI1Y0Dm1tRbar PhiC3I1Y4B1D1[c1] (ChiI1Y0Dm1Lw[sp1].uRwbar[sp1, 3, c1]) - HC[zPhiC3I1Y4B1D1ChiI1Y0Dm1tRbar PhiC3I1Y4B1D1[c1] (ChiI1Y0Dm1Lw[sp1].uRwbar[sp1, 3, c1])]
    - zPhiC3I1Y4B1D1ChiI1Y0Dm1uRbar PhiC3I1Y4B1D1[c1] (ChiI1Y0Dm1Lw[sp1].uRwbar[sp1, 1, c1]) - HC[zPhiC3I1Y4B1D1ChiI1Y0Dm1uRbar PhiC3I1Y4B1D1[c1] (ChiI1Y0Dm1Lw[sp1].uRwbar[sp1, 1, c1])]
    (* Quartic couplings *)
    - lambdaPhiC3I1Y4B1D1PhiC3I1Y4B1D1bar SU2CG22[i1, i2] PhiC3I1Y4B1D1bar[c1] PhiC3I1Y4B1D1[c1] Phitilde[i1] Phi[i2]
  , FlavorExpand -> {SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
