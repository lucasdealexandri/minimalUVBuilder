(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + DC[PhiC3I1Y4B1bar[c1], mu].DC[PhiC3I1Y4B1[c1], mu]
    + I sibar[mu, sp1, sp2] (ChiC8I1Y0Lwbar[sp1, c1].DC[ChiC8I1Y0Lw[sp2, c1], mu])
    + I sibar[mu, sp1, sp2] (ChiI1Y0Lwbar[sp1].DC[ChiI1Y0Lw[sp2], mu])
  , FlavorExpand -> {SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - (1/2)*MChiC8I1Y0 (ChiC8I1Y0Lw[sp1, c1].ChiC8I1Y0Lw[sp1, c1]) - HC[(1/2)*MChiC8I1Y0 (ChiC8I1Y0Lw[sp1, c1].ChiC8I1Y0Lw[sp1, c1])]
    - (1/2)*MChiI1Y0 (ChiI1Y0Lw[sp1].ChiI1Y0Lw[sp1]) - HC[(1/2)*MChiI1Y0 (ChiI1Y0Lw[sp1].ChiI1Y0Lw[sp1])]
    - MPhiC3I1Y4B1^2 PhiC3I1Y4B1bar[c1] PhiC3I1Y4B1[c1]
  , FlavorExpand -> {SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    (* Yukawa couplings *)
    - zPhiC3I1Y4B1ChiC8I1Y0cRbar T[c1, c2, c3] PhiC3I1Y4B1[c3] (ChiC8I1Y0Lw[sp1, c1].uRwbar[sp1, 2, c2]) - HC[zPhiC3I1Y4B1ChiC8I1Y0cRbar T[c1, c2, c3] PhiC3I1Y4B1[c3] (ChiC8I1Y0Lw[sp1, c1].uRwbar[sp1, 2, c2])]
    - zPhiC3I1Y4B1ChiC8I1Y0tRbar T[c1, c2, c3] PhiC3I1Y4B1[c3] (ChiC8I1Y0Lw[sp1, c1].uRwbar[sp1, 3, c2]) - HC[zPhiC3I1Y4B1ChiC8I1Y0tRbar T[c1, c2, c3] PhiC3I1Y4B1[c3] (ChiC8I1Y0Lw[sp1, c1].uRwbar[sp1, 3, c2])]
    - zPhiC3I1Y4B1ChiC8I1Y0uRbar T[c1, c2, c3] PhiC3I1Y4B1[c3] (ChiC8I1Y0Lw[sp1, c1].uRwbar[sp1, 1, c2]) - HC[zPhiC3I1Y4B1ChiC8I1Y0uRbar T[c1, c2, c3] PhiC3I1Y4B1[c3] (ChiC8I1Y0Lw[sp1, c1].uRwbar[sp1, 1, c2])]
    - zPhiC3I1Y4B1ChiI1Y0cRbar PhiC3I1Y4B1[c1] (ChiI1Y0Lw[sp1].uRwbar[sp1, 2, c1]) - HC[zPhiC3I1Y4B1ChiI1Y0cRbar PhiC3I1Y4B1[c1] (ChiI1Y0Lw[sp1].uRwbar[sp1, 2, c1])]
    - zPhiC3I1Y4B1ChiI1Y0tRbar PhiC3I1Y4B1[c1] (ChiI1Y0Lw[sp1].uRwbar[sp1, 3, c1]) - HC[zPhiC3I1Y4B1ChiI1Y0tRbar PhiC3I1Y4B1[c1] (ChiI1Y0Lw[sp1].uRwbar[sp1, 3, c1])]
    - zPhiC3I1Y4B1ChiI1Y0uRbar PhiC3I1Y4B1[c1] (ChiI1Y0Lw[sp1].uRwbar[sp1, 1, c1]) - HC[zPhiC3I1Y4B1ChiI1Y0uRbar PhiC3I1Y4B1[c1] (ChiI1Y0Lw[sp1].uRwbar[sp1, 1, c1])]
    (* Quartic couplings *)
    - lambdaPhiC3I1Y4B1PhiC3I1Y4B1bar SU2CG22[i1, i2] PhiC3I1Y4B1bar[c1] PhiC3I1Y4B1[c1] Phitilde[i1] Phi[i2]
  , FlavorExpand -> {SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
