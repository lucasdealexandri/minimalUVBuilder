(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

(* Kinetic terms *)
LBSMKin := Block[{mu}, ExpandIndices[
    + 1/2 DC[PhiC8I1Y0[c1], mu].DC[PhiC8I1Y0[c1], mu]
    + 1/2 DC[PhiI1Y0, mu].DC[PhiI1Y0, mu]
    + I sibar[mu, sp1, sp2] (ChiC3I1Y4B1Lwbar[sp1, c1].DC[ChiC3I1Y4B1Lw[sp2, c1], mu])
    + I sibar[mu, sp1, sp2] (ChiC3I1Y4B1Rw[sp1, c1].DC[ChiC3I1Y4B1Rwbar[sp2, c1], mu])
  , FlavorExpand -> {SU2D, SU2W}]];

(* Mass terms *)
LBSMMass := ExpandIndices[
    - (1/2)*MPhiC8I1Y0^2 PhiC8I1Y0[c1] PhiC8I1Y0[c1]
    - (1/2)*MPhiI1Y0^2 PhiI1Y0 PhiI1Y0
    - MChiC3I1Y4B1ChiC3bI1Ym4Bm1 (ChiC3bI1Ym4Bm1Lw[sp1, c1].ChiC3I1Y4B1Lw[sp1, c1]) - HC[MChiC3I1Y4B1ChiC3bI1Ym4Bm1 (ChiC3bI1Ym4Bm1Lw[sp1, c1].ChiC3I1Y4B1Lw[sp1, c1])]
  , FlavorExpand -> {SU2D, SU2W}];

(* Interactions *)
LBSMInt := ExpandIndices[
    (* Yukawa couplings *)
    - zChiC3I1Y4B1PhiC8I1Y0cRbar T[c1, c2, c3] PhiC8I1Y0[c1] (ChiC3I1Y4B1Lw[sp1, c3].uRwbar[sp1, 2, c2]) - HC[zChiC3I1Y4B1PhiC8I1Y0cRbar T[c1, c2, c3] PhiC8I1Y0[c1] (ChiC3I1Y4B1Lw[sp1, c3].uRwbar[sp1, 2, c2])]
    - zChiC3I1Y4B1PhiC8I1Y0tRbar T[c1, c2, c3] PhiC8I1Y0[c1] (ChiC3I1Y4B1Lw[sp1, c3].uRwbar[sp1, 3, c2]) - HC[zChiC3I1Y4B1PhiC8I1Y0tRbar T[c1, c2, c3] PhiC8I1Y0[c1] (ChiC3I1Y4B1Lw[sp1, c3].uRwbar[sp1, 3, c2])]
    - zChiC3I1Y4B1PhiC8I1Y0uRbar T[c1, c2, c3] PhiC8I1Y0[c1] (ChiC3I1Y4B1Lw[sp1, c3].uRwbar[sp1, 1, c2]) - HC[zChiC3I1Y4B1PhiC8I1Y0uRbar T[c1, c2, c3] PhiC8I1Y0[c1] (ChiC3I1Y4B1Lw[sp1, c3].uRwbar[sp1, 1, c2])]
    - zChiC3I1Y4B1PhiI1Y0cRbar PhiI1Y0 (ChiC3I1Y4B1Lw[sp1, c1].uRwbar[sp1, 2, c1]) - HC[zChiC3I1Y4B1PhiI1Y0cRbar PhiI1Y0 (ChiC3I1Y4B1Lw[sp1, c1].uRwbar[sp1, 2, c1])]
    - zChiC3I1Y4B1PhiI1Y0tRbar PhiI1Y0 (ChiC3I1Y4B1Lw[sp1, c1].uRwbar[sp1, 3, c1]) - HC[zChiC3I1Y4B1PhiI1Y0tRbar PhiI1Y0 (ChiC3I1Y4B1Lw[sp1, c1].uRwbar[sp1, 3, c1])]
    - zChiC3I1Y4B1PhiI1Y0uRbar PhiI1Y0 (ChiC3I1Y4B1Lw[sp1, c1].uRwbar[sp1, 1, c1]) - HC[zChiC3I1Y4B1PhiI1Y0uRbar PhiI1Y0 (ChiC3I1Y4B1Lw[sp1, c1].uRwbar[sp1, 1, c1])]
    (* Quartic couplings *)
    - lambdaPhiC8I1Y0PhiC8I1Y0 SU2CG22[i1, i2] PhiC8I1Y0[c1] PhiC8I1Y0[c1] Phitilde[i1] Phi[i2]
    - lambdaPhiI1Y0PhiI1Y0 SU2CG22[i1, i2] PhiI1Y0 PhiI1Y0 Phitilde[i1] Phi[i2]
  , FlavorExpand -> {SU2D, SU2W}];

LBSM := LBSMKin + LBSMMass + LBSMInt;
